+    if(condition) {
+        DIR *d = opendir("/private/preboot");
+        struct dirent *dir;
+        char txmPath[PATH_MAX];
+        while ((dir = readdir(d)) != NULL) {
+            if(strlen(dir->d_name) == 96) {
